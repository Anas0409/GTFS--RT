# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Topics
TOPIC_VEHICLE_POSITIONS=gtfs.vehicle_positions
TOPIC_TRIP_UPDATES=gtfs.trip_updates
TOPIC_SERVICE_ALERTS=gtfs.service_alerts

# GTFS-RT HSL (endpoints officiels — fonctionnels en 2026)
GTFS_VEHICLE_URL=https://realtime.hsl.fi/realtime/vehicle-positions/v2/hsl
GTFS_TRIP_URL=https://realtime.hsl.fi/realtime/trip-updates/v2/hsl
GTFS_ALERTS_URL=https://realtime.hsl.fi/realtime/service-alerts/v2/hsl

# Polling
POLL_INTERVAL_SECONDS=5

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=gtfs
