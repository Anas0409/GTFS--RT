# URL du flux GTFS-RT VehiclePositions (obligatoire)
# Exemples :
#   SNCF     : https://proxy.transport.data.gouv.fr/resource/sncf-ter-gtfs-rt-vehicle-positions
#   IDFM     : https://prim.iledefrance-mobilites.fr/marketplace/gtfs-rt
#   Bordeaux : https://gtfs.infotbm.com/realtime/vehiclePositions
GTFS_RT_URL=https://votre-url-gtfs-rt

# URL optionnelle d'un second flux GTFS-RT TripUpdates (retards).
# À renseigner si positions et retards sont sur deux endpoints distincts
# (ex: SNCF). Laisser vide si GTFS_RT_URL contient déjà les deux types
# d'entités (positions + retards), comme c'est souvent le cas pour IDFM.
#   SNCF : https://proxy.transport.data.gouv.fr/resource/sncf-ter-gtfs-rt-trip-updates
GTFS_RT_TRIPUPDATES_URL=

# Intervalle de fetch en secondes (défaut: 30)
FETCH_INTERVAL=30
